# Copy to .env (or export in your shell). Every variable is optional.

# Ollama endpoint for optional LLM summarisation (hybrid RAG + LLM mode).
# Leave empty to run in retrieval-only mode (no LLM calls are made).
OLLAMA_URL=
# Ollama model name used when OLLAMA_URL is set.
OLLAMA_MODEL=llama3.1

# Only used by keep_alive_cron.py / keep_alive.py (Render free-tier keep-alive).
SERVICE_URL=http://localhost:8000
